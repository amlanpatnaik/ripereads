{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && yarn install --frozen-lockfile",
  "buildCommand": "cd frontend && yarn build",
  "outputDirectory": "frontend/build",
  "trailingSlash": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
